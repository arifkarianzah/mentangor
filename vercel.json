{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/public/index.html" },
    { "source": "/admin", "destination": "/frontend/admin/dashboard.html" },
    { "source": "/admin/", "destination": "/frontend/admin/dashboard.html" },
    { "source": "/admin/:path*", "destination": "/frontend/admin/:path*" },
    { "source": "/public/:path*", "destination": "/frontend/public/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" }
  ]
}
