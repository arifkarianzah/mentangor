{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/frontend/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/frontend/public/:path*", "destination": "/public/:path*" },
    { "source": "/frontend/:path*", "destination": "/public/:path*" },
    { "source": "/public/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/login", "destination": "/admin/login.html" },
    { "source": "/login.html", "destination": "/admin/login.html" },
    { "source": "/register", "destination": "/admin/register.html" },
    { "source": "/register.html", "destination": "/admin/register.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/", "destination": "/admin/dashboard.html" }
  ]
}
